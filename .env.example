SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Recommended for this server because the API has temporary header-based identity.
# Never expose this key to a browser or commit it.
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Alternatively, use SUPABASE_SERVICE_ROLE_KEY for older Supabase projects.
FLASK_DEBUG=false
